{
  "uid": "mlops-pipeline",
  "title": "Конвейер",
  "tags": [
    "MLOps"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "worker",
        "label": "Воркер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pipeline-prometheus"
        },
        "query": {
          "query": "label_values(mlops_worker_inflight, instance)",
          "refId": "workers"
        },
        "definition": "label_values(mlops_worker_inflight, instance)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "log_service",
        "label": "Сервис в логах",
        "type": "custom",
        "query": "api,source,worker",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "slo",
        "label": "Порог SLO, с",
        "type": "custom",
        "query": "1,2,3,4,5,10,20,60",
        "current": {
          "text": "3",
          "value": "3"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Очередь RabbitMQ",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9,
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Готовы к доставке",
          "expr": "rabbitmq_detailed_queue_messages_ready{queue_role=\"work\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        },
        {
          "refId": "B",
          "legendFormat": "Не подтверждены",
          "expr": "rabbitmq_detailed_queue_messages_unacked{queue_role=\"work\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        },
        {
          "refId": "C",
          "legendFormat": "Лимит ready",
          "expr": "mlops_queue_limit > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        },
        {
          "refId": "D",
          "legendFormat": "DLQ",
          "expr": "rabbitmq_detailed_queue_messages_ready{queue_role=\"dlq\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Скорость конвейера",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9,
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Источник",
          "expr": "sum(rate(mlops_source_published_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        },
        {
          "refId": "B",
          "legendFormat": "Воркеры · всего",
          "expr": "sum(rate(mlops_worker_tasks_total{outcome=\"ok\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        },
        {
          "refId": "C",
          "legendFormat": "Воркер {{instance}}",
          "expr": "sum by (instance) (rate(mlops_worker_tasks_total{outcome=\"ok\",instance=~\"$worker\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Inference · перцентили",
      "description": "",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
