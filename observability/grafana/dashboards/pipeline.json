        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mlops_inference_duration_seconds_bucket{instance=~\"$worker\"}[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": true
