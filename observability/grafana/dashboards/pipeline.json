          "refId": "A",
          "legendFormat": "Успешные в пределах порога",
          "expr": "(sum(increase(mlops_task_duration_seconds_bucket{le=\"$slo\"}[5m])) or vector(0)) / (((sum(increase(mlops_task_duration_seconds_count[5m])) or vector(0)) + (sum(increase(mlops_worker_tasks_total{outcome=\"dlq\"}[5m])) or vector(0))) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "pipeline-prometheus"
          },
          "range": true,
          "exemplar": false
        },
        {
          "refId": "B",
