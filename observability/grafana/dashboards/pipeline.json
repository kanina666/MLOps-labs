    {
      "id": 10,
      "title": "SLO · результаты быстрее $slo с",
      "description": "За последние 5 минут. Знаменатель включает успешные результаты и DLQ. Ожидающие задачи появятся в расчёте после терминального исхода.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pipeline-prometheus"
      },
      "fieldConfig": {
