APP_VERSION=0.1.0
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TIMEOUT=0.5
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRIC_EXPORT_INTERVAL=2000
OTEL_METRIC_EXPORT_TIMEOUT=1000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_SCHEDULE_DELAY=1000
DEPLOYMENT_ENV=dev
LOG_LEVEL=INFO
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

ALLOY_VERSION=v1.10.2
LOKI_VERSION=3.5.3
TEMPO_VERSION=2.8.2
OTEL_COLLECTOR_VERSION=0.133.0
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.1
GRAFANA_PASSWORD=local-grafana

RABBITMQ_MAX_QUEUE_LENGTH=10
RABBITMQ_PREFETCH_COUNT=1
INFERENCE_DELAY_MS=200
